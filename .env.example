# ==============================================================================
# Infera Environment Configuration
# ₹0 Budget Deployment & Local Development
# ==============================================================================

# Backend Service
PROJECT_NAME=Infera
VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS Configuration (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]

# Safety & Memory Limits for Free-Tier Execution
MAX_UPLOAD_SIZE_BYTES=15728640  # 15 MB
MAX_ROW_COUNT=50000
DATASET_CACHE_TTL_SECONDS=3600

# Frontend Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
