# ==============================================================================
# Infera Environment Configuration
# Zero-Budget Deployment (Render Free Backend + Vercel Hobby Frontend)
# ==============================================================================

# --- BACKEND (Render Free Web Service) ---
# Set these in the Render Dashboard -> Environment Variables:
PROJECT_NAME=Infera
VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Production CORS Origins:
# Enter your deployed Vercel frontend URL, custom domain, and local dev ports.
# Supports both comma-separated strings or JSON lists:
# Example: https://infera-omega.vercel.app,http://localhost:3000
CORS_ORIGINS=["https://infera-omega.vercel.app","http://localhost:3000"]

# Resource & Concurrency Safeguards for 512 MB RAM / 0.1 CPU
MAX_UPLOAD_SIZE_BYTES=15728640        # 15 MB file upload limit
MAX_ROW_COUNT=50000                   # Maximum row count before sampling required
MAX_COLUMN_COUNT=100                  # Maximum column count to protect RAM
DATASET_CACHE_TTL_SECONDS=3600        # In-memory session lifetime (1 hour)
MAX_CACHED_DATASETS=20                # In-memory LRU session capacity
MAX_CONCURRENT_ANALYSES=1             # Keep at 1 on Render Free to bound concurrent workloads
ANALYSIS_SEMAPHORE_TIMEOUT_SECONDS=10 # Wait time before returning HTTP 429

# --- FRONTEND (Vercel Hobby Project) ---
# Set this in Vercel Project Settings -> Environment Variables:
# Production: copy the actual HTTPS service origin from Render once deployed.
NEXT_PUBLIC_API_URL=http://localhost:8000
